# Zoho OAuth (EU)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# EU endpoints (defaults)
ZOHO_API_BASE=https://www.zohoapis.eu/crm/v2
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.eu

# PrintIQ (API)
PRINTIQ_BASE_URL=https://<yourtenant>.printiq.com
PRINTIQ_API_NAME=<ApplicationName>
PRINTIQ_API_KEY=<ApplicationKey>

# Optional (only if your org requires/you choose to enforce it later)
ZOHO_ORG_ID=

# Local server
PORT=3000

# Dedupe TTL in ms (default 24h)
DEDUPE_TTL_MS=86400000